# Copy this file to config/pi-image.env and edit the values before building.
# Do not commit config/pi-image.env because it may contain passwords.

# Official Raspberry Pi OS Lite 64-bit Bookworm image.
PI_IMAGE_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2024-11-19/2024-11-19-raspios-bookworm-arm64-lite.img.xz"

# Optional. Leave empty to skip checksum verification, or paste the SHA-256
# checksum published next to the Raspberry Pi OS image.
PI_IMAGE_SHA256=""

PI_HOSTNAME="telegramtestone-pi"
PI_USERNAME="pi"
PI_PASSWORD="change-me-before-flashing"

# Prefer an SSH key over password login. Example:
# PI_SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA..."
PI_SSH_PUBLIC_KEY=""

# Leave Wi-Fi values empty if you will use Ethernet on first boot.
PI_WIFI_COUNTRY="US"
PI_WIFI_SSID=""
PI_WIFI_PASSWORD=""

PI_TIMEZONE="UTC"
PI_LOCALE="en_US.UTF-8"
PI_APP_DIR="/opt/telegramTestOne"

# Adds free space to the expanded image before customization.
PI_EXTRA_IMAGE_MB="1024"
